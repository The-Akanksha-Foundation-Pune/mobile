DATABASE_URL="mysql://root:your_password@localhost:3306/LocalDB"
# Or set DB_* below — DATABASE_URL is auto-built on startup when DATABASE_URL is unset.
# Cost centres come from one of two sources:
#  - COSTCENTER_SOURCE=employees: distinct cost_centre_mapped values in AFDW.employees (AFDW_* below),
#    with users linked to their own centre at login by work email
#  - otherwise the Finance ERP table below (same MySQL server; user needs SELECT on it)
# COSTCENTER_SOURCE=employees
FINANCE_COSTCENTER_TABLE=Finance.costcenter
# FINANCE_COSTCENTER_SYNC=false
# FINANCE_COSTCENTER_REQUIRED=true
# Override column names if auto-detect fails:
# Finance.costcenter columns (Akanksha ERP):
FINANCE_CC_COL_ID=id
FINANCE_CC_COL_NAME=costcenter
FINANCE_CC_COL_CITY=city
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=LocalDB
# Production (AWS RDS): leave DATABASE_URL unset and set DB_* — DATABASE_URL takes priority over DB_*.
# SSL is added automatically for amazonaws.com hosts.
# DB_HOST=your-instance.xxxxxxxx.ap-south-1.rds.amazonaws.com
# DB_NAME=captureakankshaapp
# AFDW employees (same MySQL server) — used to check who can sign in
AFDW_DB_NAME=AFDW
AFDW_EMPLOYEES_TABLE=employees
# Set DB_SSL=true for managed MySQL that requires TLS (AWS RDS auto-detects amazonaws.com hosts)
# DB_SSL=true
PORT=4000
# Optional — remote testing via ngrok (npm run tunnel:start); never commit a real token
# NGROK_AUTHTOKEN=your_ngrok_authtoken
# Generate: openssl rand -base64 48
JWT_SECRET=replace_with_long_random_secret
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# Web OAuth client (same as GOOGLE_CLIENT_ID for hosted web login):
# GOOGLE_WEB_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_oauth_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_oauth_ios_client_id.apps.googleusercontent.com
# Optional comma-separated fallback list, if you want one setting for all:
# GOOGLE_CLIENT_IDS=web.apps.googleusercontent.com,android.apps.googleusercontent.com,ios.apps.googleusercontent.com
# Google Calendar connect (Special Access users): client secret of the WEB OAuth client above.
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret
# Web app: Google returns to the app's own origin (already registered for sign-in), nothing more to add.
# Phones only: Google returns to this backend URL, which must be listed under "Authorised redirect URIs"
# on that web client (https, e.g. ngrok or the EC2 backend domain). Defaults to <backend origin>/api/calendar/google/callback.
# GOOGLE_CALENDAR_REDIRECT_URI=https://your-backend-host/api/calendar/google/callback
ALLOWED_EMAIL_DOMAIN=akanksha.org
GOOGLE_AI_API_KEY=your_google_ai_api_key
# Optional model override, tried before the built-in list (gemini-3.1-pro-preview, gemini-3.8-flash, gemini-3.5-flash-lite).
# All gemini-2.x names were retired by Google in 2026. Pro models need paid credit; Flash models run on prepaid AI Studio credit.
# GOOGLE_AI_MODEL=gemini-3.8-flash
# Same key as Cursor Settings → Models → Google API Key (Google AI Studio)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Media: auto = Drive when fully configured, else local disk under backend/uploads + /media URLs
# MEDIA_STORAGE=auto
# Force disk-only (no Drive): MEDIA_STORAGE=local
# Force Drive only (503 if misconfigured): MEDIA_STORAGE=google
# Optional base URL for /media links when behind a proxy, ngrok, or Vercel:
# PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# PUBLIC_API_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# Production: PUBLIC_API_BASE_URL=https://mobile-sand-chi.vercel.app
# Preview (main branch): PUBLIC_API_BASE_URL=https://mobile-git-main-akanksha-dev-teams-projects.vercel.app
PUBLIC_API_BASE_URL=https://mobile-sand-chi.vercel.app

# Comma-separated emails that become Super Admin at login (the legacy admin@ prefix also works)
SUPER_ADMIN_EMAILS=
# Optional: verify the AWS RDS certificate (otherwise the connection is encrypted but unverified):
# curl -o certs/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL_CA=certs/rds-global-bundle.pem
