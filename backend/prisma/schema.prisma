generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  donor
  special
  super_admin
}

enum MediaType {
  photo
  video
}

enum EventStatus {
  upcoming
  ongoing
  complete
}

enum ReviewStatus {
  pending
  approved
}

enum ContentKind {
  event
  post
  story
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          UserRole @default(user)
  googleSub     String   @unique
  /// AFDW employees.employee_code; the stable link to the HR record (email can change).
  employeeCode  String?  @unique
  profileImage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cityId        String?
  city          City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  costCenterId  String?
  costCenter    CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  uploadedEvents Event[]
  googleCalendar GoogleCalendarConnection?

  @@index([cityId])
  @@index([costCenterId])
}

/// A user's linked Google Calendar (OAuth tokens for the calendar.readonly scope).
model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  scope        String?  @db.Text
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EventType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  state     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  costCenters      CostCenter[]
  events           Event[]
  calendarEntries  CalendarEntry[]
  users            User[]
}

model CostCenter {
  id          String   @id @default(cuid())
  financeId   String?  @unique
  code        String   @unique
  name        String
  description String?  @db.Text
  cityId      String?
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  donors           Donor[]
  events           Event[]
  calendarEntries  CalendarEntry[]
  notifications    DonorNotification[]
  users            User[]

  @@index([cityId])
}

model Donor {
  id            String     @id @default(cuid())
  email         String
  name          String
  costCenterId  String
  costCenter    CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  notifications DonorNotification[]

  @@unique([email, costCenterId])
  @@index([costCenterId])
}

/** Key/value settings editable from the Admin console (e.g. per-user limits). */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/** How many times a user has run "Polish with AI" on one draft description (draftId is minted by the client per form). */
model AiPolishUsage {
  id        String      @id @default(cuid())
  userId    String
  draftId   String
  kind      ContentKind @default(post)
  count     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, draftId])
  @@index([updatedAt])
}

model DonorNotification {
  id           String     @id @default(cuid())
  donorId      String
  donor        Donor      @relation(fields: [donorId], references: [id], onDelete: Cascade)
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  subject      String
  message      String     @db.Text
  sentAt       DateTime   @default(now())

  @@index([costCenterId])
  @@index([eventId])
  @@index([donorId])
}

model CalendarEntry {
  id            String     @id @default(cuid())
  title         String
  description   String?    @db.Text
  eventDate     DateTime
  endDate       DateTime?
  location      String?
  cityId        String?
  city          City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  costCenterId  String?
  costCenter    CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  isPublished   Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([cityId])
  @@index([costCenterId])
  @@index([eventDate])
}

model Event {
  id                 String      @id @default(cuid())
  title              String?
  caption            String      @db.Text
  eventDate          DateTime
  location           String?
  eventStatus        EventStatus @default(upcoming)
  /** Last day the event is live; same as eventDate when unset. Status is derived from these dates. */
  endDate            DateTime?
  approvedForGallery Boolean     @default(false)
  reviewStatus       ReviewStatus @default(pending)
  reviewedById       String?
  reviewedAt         DateTime?
  kind               ContentKind @default(event)
  parentEventId      String?
  body               String?     @db.Text
  mediaType          MediaType
  mediaUrl           String
  mediaDriveFileId   String
  originalName       String
  uploadedByName     String?
  /** Set when the event was imported from Google Calendar; stops the same event being imported twice. */
  googleEventId      String?     @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  typeId             String?
  costCenterId       String?
  cityId             String?
  uploadedById       String
  eventType          EventType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  costCenter         CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  city               City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  uploadedBy         User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  parentEvent        Event?      @relation("EventContributions", fields: [parentEventId], references: [id], onDelete: SetNull)
  posts              Event[]     @relation("EventContributions")
  notifications      DonorNotification[]

  @@index([typeId])
  @@index([uploadedById])
  @@index([eventDate])
  @@index([costCenterId])
  @@index([cityId])
  @@index([eventStatus])
  @@index([approvedForGallery])
  @@index([reviewStatus])
  @@index([kind])
  @@index([parentEventId])
}
